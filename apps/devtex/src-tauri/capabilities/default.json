{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: DevTex commands, event listening for watcher/menu events, and the folder picker. No fs/shell/http plugins.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-set-title",
    "core:window:allow-set-theme",
    "core:webview:allow-set-webview-zoom",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "ios-bookmarks:default",
    "allow-platform",
    "allow-open-project",
    "allow-list-files",
    "allow-read-file",
    "allow-read-bytes",
    "allow-stat-file",
    "allow-save-file",
    "allow-compile",
    "allow-cancel-compile",
    "allow-read-synctex",
    "allow-cached-synctex",
    "allow-push-review",
    "allow-set-token",
    "allow-has-token",
    "allow-delete-token",
    "allow-bbt-rpc",
    "allow-read-config",
    "allow-write-config",
    "allow-list-syntax-files",
    "allow-list-theme-files",
    "allow-config-location",
    "allow-open-config-folder",
    "allow-system-appearance",
    "allow-resolve-open-paths",
    "allow-take-opened-paths"
  ]
}
